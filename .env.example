# 复制本文件为 .env 并填入你的密钥。.env 已在 .gitignore 中，不会被提交。
# ⚠️ 绝不要把真实密钥提交到 git 或发给任何人。

# ==== OKX（先用【模拟盘】API key）====
# 申请：OKX -> 交易 -> 模拟交易 -> 生成模拟盘 API Key
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# OKX_DEMO=1 走模拟盘（默认，安全）；=0 才是真实资金（请务必先跑稳模拟盘）
OKX_DEMO=1

# ==== 信号变化通知（都可选，填了哪个就启用哪个）====
# 微信推送 Server酱：https://sct.ftqq.com 微信扫码 → SendKey
SERVERCHAN_KEY=
# 微信推送 PushPlus：https://www.pushplus.plus 微信扫码 → token
PUSHPLUS_TOKEN=
# Telegram：@BotFather 建 bot 拿 token，getUpdates 里找 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 邮件（QQ邮箱示例）：SMTP服务开启后拿"授权码"填 SMTP_PASS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_TO=
